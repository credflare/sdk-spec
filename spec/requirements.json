{
  "version": 1,
  "verification_types": [
    "facial_verification",
    "location_verification",
    "email_verification",
    "phone_verification"
  ],
  "contact_codes": {
    "channels": {
      "email": "email_verification",
      "phone": "phone_verification"
    },
    "code_length": 6,
    "ttl_minutes": 10,
    "max_attempts": 5,
    "resend_seconds": 60,
    "max_sends": 5,
    "send_window_hours": 24,
    "email_max_length": 254,
    "phone_max_length": 32,
    "phone_strip": "[\\s().-]",
    "phone_pattern": "^\\+[1-9][0-9]{6,14}$"
  },
  "questions": {
    "types": [
      "text",
      "textarea",
      "email",
      "number",
      "date",
      "select",
      "tel",
      "founders",
      "phone",
      "single_select",
      "multi_select",
      "country",
      "consent"
    ],
    "choice_types": [
      "select",
      "single_select",
      "multi_select"
    ],
    "key_pattern": "^[A-Za-z][A-Za-z0-9_-]{0,99}$",
    "max_options": 100,
    "max_option_length": 200,
    "text_max_length": 5000,
    "number_pattern": "^-?[0-9]+(\\.[0-9]+)?$",
    "date_pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "phone_pattern": "^\\+?[0-9][0-9 ().-]{4,30}$",
    "country_pattern": "^[A-Z]{2}$",
    "email_max_length": 254
  },
  "show_if": {
    "match": [
      "all",
      "any"
    ],
    "default_match": "all",
    "max_conditions": 10,
    "path_prefix": "form.",
    "operators": [
      "equals",
      "not_equals",
      "gt",
      "gte",
      "lt",
      "lte",
      "contains",
      "not_contains",
      "in",
      "not_in",
      "is_empty",
      "is_not_empty",
      "regex",
      "fuzzy_match"
    ],
    "max_list_values": 100,
    "max_pattern_length": 200,
    "fuzzy_default_min_score": 80
  },
  "refresh": {
    "after": [
      "submit",
      "email_code_confirm",
      "phone_code_confirm"
    ],
    "open_statuses": [
      "pending",
      "in_progress"
    ],
    "outstanding": [
      "profile.document_requirements",
      "profile.verification_requirements",
      "profile.form_schema"
    ]
  }
}
